# ---------------------------------------------------------------- app
APP_ENV=local
LOG_LEVEL=INFO
BASE_CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
PUBLIC_BASE_URL=https://api.seudominio.com

# ---------------------------------------------------------------- banco
DB_CONN=postgresql+psycopg://fdm:SENHA@db:5432/fdm
DB_POOL_SIZE=10

# ---------------------------------------------------------------- APIs de voo
USE_MOCK_SOURCES=true
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://test.api.amadeus.com
SKYSCANNER_API_KEY=
KIWI_API_KEY=
# Google Flights REAL via SerpAPI (https://serpapi.com/google-flights-api) - plano pago
SERPAPI_API_KEY=

# ---------------------------------------------------------------- câmbio
FX_PROVIDER_URL=https://api.frankfurter.app/latest
FX_FALLBACK_URL=https://economia.awesomeapi.com.br/json/last
FX_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------- coleta
RATE_LIMIT_PER_SOURCE_RPS=2
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE=1.5
HTTP_BACKOFF_MAX=60

# ---------------------------------------------------------------- mercado
MARKET_MIN_SAMPLES=5
MARKET_TEMPORAL_HALF_LIFE_HOURS=72
MARKET_IQR_MULTIPLIER=1.5
MARKET_MAX_AGE_HOURS=168
SOURCE_RELIABILITY=amadeus=1.00,skyscanner=0.85,kiwi=0.75,google_flights=0.70

# ---------------------------------------------------------------- monitoramento
DEFAULT_SCAN_INTERVAL_HOURS=6
DEFAULT_DEBOUNCE_HOURS=24
DEFAULT_DROP_PCT=5
MAX_ALERTS_PER_WATCH_PER_DAY=3
SCHEDULER_TICK_SECONDS=30
WATCH_RELOAD_SECONDS=60

# ---------------------------------------------------------------- fila
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=
WORKER_CONCURRENCY=8

# ---------------------------------------------------------------- notificações
NOTIFY_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SHORTLINK_DOMAIN=https://voos.seudominio.com/r

# ---------------------------------------------------------------- segurança
OAUTH2_ISSUER=https://auth.seudominio.com/
OAUTH2_AUDIENCE=flight-deal-monitor
JWT_PUBLIC_KEY=
WEBHOOK_SIGNING_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------- observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
SRE_ERROR_RATE_ALERT=0.05
